# Copiá este archivo como .env.local y completá los valores.
# Nunca subas .env.local al repositorio.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Link privado de cada pedido (/pedido/[token]) y límite de pedidos por IP.
# Generá uno con: openssl rand -hex 32   (mínimo 32 caracteres; si se cambia, los links viejos dejan de andar)
PEDIDO_TOKEN_SECRET=

# Pago: transferencia común a la cuenta de Nevada (sin comisión). El comprador sube el comprobante
# y el admin aprueba en «Por aprobar». Si no se completa, el alias es nevadaoncativo.
PAGO_ALIAS=nevadaoncativo
# Nombre del titular que ve el comprador al transferir (opcional, ayuda a que confíe).
PAGO_TITULAR=

# Resend (etapa 6)
RESEND_API_KEY=
EMAIL_FROM="Nevada Producciones <entradas@nevadaproducciones.com>"

# Firma de los QR de las entradas (las que genera el RRPP en efectivo ya los usan).
# Generá uno con: openssl rand -hex 32. Si se cambia, los QR ya emitidos dejan de validar.
QR_SIGNING_SECRET=

# URL pública del sitio (para links de pago y de entradas)
# Desarrollo: http://localhost:3000 · Producción: https://www.nevadaproducciones.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
