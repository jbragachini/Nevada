# Copiá este archivo como .env.local y completá los valores.
# Nunca subas .env.local al repositorio.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (etapa 6)
RESEND_API_KEY=
EMAIL_FROM="Nevada Producciones <entradas@nevadaproducciones.com>"

# Firma de los QR (etapa 6). Generá uno con: openssl rand -hex 32
QR_SIGNING_SECRET=

# URL pública del sitio (para links de pago y de entradas)
# Desarrollo: http://localhost:3000 · Producción: https://www.nevadaproducciones.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
